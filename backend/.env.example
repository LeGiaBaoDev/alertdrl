# ====== CẤU HÌNH ALERTDRL BACKEND ======
# Copy file này thành ".env" rồi điền giá trị thật.

# --- Trang cần theo dõi ---
TARGET_URL=https://doantn.iuh.edu.vn/doanvien.html@211@Tra-cuu

# Cookie phiên đăng nhập của bạn (BẮT BUỘC vì trang cần login).
# Cách lấy: mở Chrome > đăng nhập trang > F12 > tab Network > refresh >
# click request "doanvien.html..." > Headers > Request Headers > copy nguyên dòng "cookie:".
# Dán toàn bộ chuỗi vào đây (trong 1 dòng).
COOKIE=

# Bao lâu kiểm tra 1 lần (cron). Mặc định mỗi 5 phút.
CRON_SCHEDULE=*/5 * * * *

# --- Kênh thông báo ---
# Bật/tắt từng kênh. true/false.

# 1) ntfy (MIỄN PHÍ, dùng được ngay - cài app "ntfy" trên iPhone, subscribe topic bên dưới)
NTFY_ENABLED=true
NTFY_SERVER=https://ntfy.sh
# Đặt 1 topic KHÓ ĐOÁN (coi như mật khẩu). Ví dụ: alertdrl-giabao-9f3k2x
NTFY_TOPIC=

# 2) Expo Push (cho app iOS native - cần build app Expo + tài khoản Apple Developer cho push thật)
EXPO_ENABLED=false

# --- HTTP server (để app Expo đăng ký push token) ---
PORT=3000
